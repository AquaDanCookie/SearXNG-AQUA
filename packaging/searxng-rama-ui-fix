#!/bin/bash
# (Re-)apply the local RAMA theme UI fixes to the served theme assets.
# Replaces previously applied blocks, so it can run repeatedly (package
# upgrades, theme switches) without duplicating anything.
set -u

FIX="/usr/local/share/searxng-rama/ui-fix.css"
FIXJS="/usr/local/share/searxng-rama/ui-fix.js"
DIR="/opt/searxng-rama/searx/static/themes/simple"
MARK="RAMA-UI-FIX v1"
JSMARK="RAMA-UI-JS v1"

[ -d "$DIR" ] || exit 0

for f in "$DIR"/sxng-ltr*.min.css "$DIR"/sxng-rtl*.min.css; do
  [ -r "$FIX" ] || break
  [ -e "$f" ] || continue
  python3 - "$f" "$FIX" "$MARK" <<'PY'
import sys
path, fixpath, mark = sys.argv[1], sys.argv[2], sys.argv[3]
current = open(path, encoding="utf-8").read()
marker = "/* " + mark
i = current.find(marker)
base = current[:i].rstrip("\n") + "\n" if i != -1 else current
fix = open(fixpath, encoding="utf-8").read().lstrip("\n")
new = base + "\n" + fix
if new != current:
    open(path, "w", encoding="utf-8").write(new)
PY
done

# The colour customisation lives in the theme's JS entry bundle, which is
# shared by every theme variant and every page.
JS="$DIR/sxng-core.min.js"
if [ -r "$FIXJS" ] && [ -e "$JS" ]; then
  python3 - "$JS" "$FIXJS" "$JSMARK" <<'PY'
import sys
path, fixpath, mark = sys.argv[1], sys.argv[2], sys.argv[3]
current = open(path, encoding="utf-8").read()
start_marker = "/* " + mark
end_marker = "/* /" + mark + " */"
start = current.find(start_marker)
if start != -1:
    end = current.find(end_marker, start)
    if end != -1:
        current = current[:start] + current[end + len(end_marker):]
    else:
        current = current[:start]
current = current.rstrip("\n") + "\n"
fix = open(fixpath, encoding="utf-8").read().strip()
new = current + "\n" + fix + "\n"
if new != open(path, encoding="utf-8").read():
    open(path, "w", encoding="utf-8").write(new)
PY
fi

# WhiteNoise indexes the static tree when the app starts; a restart is needed
# before the patched assets (or a freshly swapped theme variant) are served.
if systemctl is-enabled --quiet searxng-rama.service 2>/dev/null; then
  systemctl restart searxng-rama.service 2>/dev/null || true
elif pgrep -f '[s]earx.webapp' >/dev/null 2>&1; then
  echo "searxng-rama: UI fixes installed; close and reopen the SearXNG RAMA window to load them."
fi

exit 0
