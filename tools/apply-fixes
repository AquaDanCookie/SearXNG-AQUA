#!/usr/bin/env bash
# Re-apply the project's UI fixes to the local app's theme bundles.
# Run as aqua (the app files are owned by aqua). No root needed.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIX="$ROOT/fixes/ui-fix.css"
FIXJS="$ROOT/fixes/ui-fix.js"
DIR="$ROOT/app/searx/static/themes/simple"
CSS_MARK="RAMA-UI-FIX v1"
JS_MARK="RAMA-UI-JS v1"

[ -d "$DIR" ] || { echo "No app at $ROOT/app" >&2; exit 1; }
[ -r "$FIX" ] || { echo "Missing $FIX" >&2; exit 1; }
[ -r "$FIXJS" ] || { echo "Missing $FIXJS" >&2; exit 1; }

for f in "$DIR"/sxng-ltr*.min.css "$DIR"/sxng-rtl*.min.css; do
  [ -e "$f" ] || continue
  python3 - "$f" "$FIX" "$CSS_MARK" <<'PY'
import sys
path, fixpath, mark = sys.argv[1], sys.argv[2], sys.argv[3]
current = open(path, encoding="utf-8").read()
marker = "/* " + mark
i = current.find(marker)
base = current[:i].rstrip("\n") + "\n" if i != -1 else current
fix = open(fixpath, encoding="utf-8").read().lstrip("\n")
new = base + "\n" + fix
if new != current:
    open(path, "w", encoding="utf-8").write(new)
PY
done

JS="$DIR/sxng-core.min.js"
python3 - "$JS" "$FIXJS" "$JS_MARK" <<'PY'
import sys
path, fixpath, mark = sys.argv[1], sys.argv[2], sys.argv[3]
current = open(path, encoding="utf-8").read()
start_marker = "/* " + mark
end_marker = "/* /" + mark + " */"
start = current.find(start_marker)
if start != -1:
    end = current.find(end_marker, start)
    if end != -1:
        current = current[:start] + current[end + len(end_marker):]
    else:
        current = current[:start]
current = current.rstrip("\n") + "\n"
fix = open(fixpath, encoding="utf-8").read().strip()
new = current + "\n" + fix + "\n"
if new != open(path, encoding="utf-8").read():
    open(path, "w", encoding="utf-8").write(new)
PY

echo "Fixes applied to $ROOT/app."
echo "Reload the SearXNG page (or close and reopen the SearXNG window) to load them."
